{
  "name": "draft-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "catalog:dry-run": "node scripts/dry-run-player-catalog.mjs",
    "catalog:prepare-update": "node scripts/prepare-player-catalog-update.mjs",
    "catalog:prepare-preseason-sync": "node scripts/prepare-preseason-player-sync.mjs",
    "dev": "VITE_USE_FIREBASE_EMULATORS=true VITE_FIREBASE_PROJECT_ID=demo-draft-board-stress vite",
    "dev:emulators": "VITE_USE_FIREBASE_EMULATORS=true VITE_FIREBASE_PROJECT_ID=demo-draft-board-stress vite",
    "dev:remote": "VITE_ALLOW_REMOTE_FIREBASE=true vite",
    "build": "vite build",
    "build:github": "VITE_BASE_PATH=/draft-board/ vite build",
    "firebase:deploy": "firebase deploy",
    "firebase:emulators": "npx --yes firebase-tools@13 emulators:start --project demo-draft-board-stress --only auth,database,functions",
    "firebase:seed": "node scripts/seed-local-emulator.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test src/**/*.test.js",
    "test:rules": "npx --yes firebase-tools@13 emulators:exec --only database --project demo-draft-board-rules \"node --test tests/database.rules.test.mjs\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.13.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.24.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
