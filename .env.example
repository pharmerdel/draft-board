# Front-door league access password.
# For local testing only, the app falls back to "draftday" when neither value is set.
#
# Simpler option:
# VITE_LEAGUE_PASSWORD=replace-this-before-production
#
# Better option: store only a SHA-256 hash of the password in the built app.
# If this is set, it takes priority over VITE_LEAGUE_PASSWORD.
# VITE_LEAGUE_PASSWORD_SHA256=

# Local Emulator Suite. Prefer `npm run dev:emulators`, which supplies these
# values without reading or writing any configured Firebase project.
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=demo-draft-board-stress
# VITE_ALLOW_REMOTE_FIREBASE=true
